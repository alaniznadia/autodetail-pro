# Base de datos (Supabase, Railway, o Postgres local)
DATABASE_URL="postgresql://usuario:password@localhost:5432/epicshine?schema=public"
# Conexión directa (sin pgbouncer) para migraciones. En Postgres local o
# Railway, poné el mismo valor que DATABASE_URL. En Supabase, usá la URL
# del pooler en modo "Session" (puerto 5432) en vez de la de DATABASE_URL
# (modo "Transaction", puerto 6543).
DIRECT_URL="postgresql://usuario:password@localhost:5432/epicshine?schema=public"

# Auth.js — generar con: npx auth secret
AUTH_SECRET="reemplazar-con-un-secreto-generado"

# URL pública del sitio (usada en metadata/SEO y en los callbacks de Mercado Pago)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Mercado Pago (Checkout Pro). Sacar las credenciales de prueba desde
# https://www.mercadopago.com.ar/developers/panel/app -> "Credenciales de prueba".
# El access token de PRODUCCIÓN recién se usa cuando la tienda ya está en vivo.
MERCADOPAGO_ACCESS_TOKEN=""
MERCADOPAGO_PUBLIC_KEY=""
# Secreto de firma del webhook: se genera en la misma app, sección "Webhooks".
MERCADOPAGO_WEBHOOK_SECRET=""

# Notificaciones por email (confirmación de pedido y cambios de estado).
# Cualquier proveedor SMTP sirve (Gmail con contraseña de aplicación,
# SendGrid, Mailgun, Resend con su SMTP relay, etc.). Sin SMTP_HOST
# configurado, los emails se saltan con un aviso en consola en vez de
# romper el checkout o el cambio de estado que los dispara.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="Epic Shine <no-reply@epicshine.com.ar>"

# Notificaciones por WhatsApp (mismo evento que el email: confirmación de
# pedido y cambios de estado), usando la API de WhatsApp de Twilio.
# Cuenta en https://www.twilio.com/console -> Messaging -> Try WhatsApp
# (sandbox gratis para pruebas; para producción hace falta un número de
# WhatsApp Business verificado). Sin estas 3 variables, el envío se salta
# con un aviso en consola en vez de romper el pedido que lo dispara.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
# Formato "whatsapp:+14155238886" (así lo muestra la consola de Twilio).
TWILIO_WHATSAPP_FROM=""

# Imágenes de producto (Vercel Blob). En Vercel: Storage -> Create Database
# -> Blob, se conecta al proyecto y esta variable se carga sola. En local,
# se puede dejar vacía (la subida de imágenes solo funciona si está seteada).
BLOB_READ_WRITE_TOKEN=""

# Importar stock desde remito en PDF o foto de ticket (Compras -> Importar
# remito): la IA de Claude lee el documento y extrae los ítems para
# hacer matching automático contra los productos existentes. Se obtiene
# en https://console.anthropic.com/settings/keys. Sin esta variable, la
# importación de remitos no funciona (la carga manual de compras sigue
# funcionando igual).
ANTHROPIC_API_KEY=""
# Modelo usado para leer el remito. Cambiar solo si Anthropic publica un
# modelo más nuevo y se quiere migrar sin tocar código.
ANTHROPIC_MODEL="claude-sonnet-5"

# Envíos (dejar vacío hasta contratar cuenta comercial)
CORREO_ARGENTINO_API_KEY=""
ANDREANI_API_KEY=""

# Usuario admin inicial (usado solo por prisma/seed.ts)
SEED_ADMIN_EMAIL="admin@epicshine.com.ar"
SEED_ADMIN_PASSWORD="CambiarEstaClave123!"
